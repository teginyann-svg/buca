{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@local/reservation-link": ["./src/lib/empty-local-link.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/vite-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/views/**/*.tsx",
    "src/App.tsx",
    "src/middleware.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src/main.tsx", "dist"]
}
