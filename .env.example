# Code d’accès pages admin (/#/semaine, /#/clients, calculateur)
SALON_ADMIN_CODE=

# --- Persistance prod (recommandé) : Supabase free ---
# SQL : exécuter supabase/schema.sql dans le SQL Editor
# Puis seed : npm run data:seed-supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fallback fichiers JSON (dev local sans Supabase, ou VPS avec disque)
# DATA_DIR=

# --- Front Vite (ReactPress) ---
# Page publique : https://kod200.com/buca
# VITE_API_BASE=https://buca.onrender.com

# Origines CORS (domaine WordPress)
CORS_ORIGINS=https://kod200.com,https://www.kod200.com,http://localhost:3000

# --- Migration one-shot depuis Google (optionnel) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=redroomcoiffure@gmail.com
