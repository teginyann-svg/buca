# Google OAuth (Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtained via: npm run auth:google
GOOGLE_REFRESH_TOKEN=

# Calendar to read/write (email of the salon account, or "primary")
GOOGLE_CALENDAR_ID=redroomcoiffure@gmail.com

# Agenda Google des jours fériés suisses (déjà abonné sur le compte salon)
# GOOGLE_HOLIDAYS_CALENDAR_ID=fr.ch#holiday@group.v.calendar.google.com

# Code d’accès à la page récap /semaine (choisissez un code secret)
SALON_ADMIN_CODE=

# --- Front Vite (ReactPress) ---
# Page publique : https://kod200.com/buca
# URL de l’API Render (sans slash final) — obligatoire au build ReactPress :
# VITE_API_BASE=https://reservsalon-api.onrender.com

# Origines CORS (domaine WordPress)
CORS_ORIGINS=https://kod200.com,https://www.kod200.com,http://localhost:3000
